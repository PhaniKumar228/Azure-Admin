#Requires -Version 5.1
<#
.SYNOPSIS
    Compares database properties between two SQL Server instances using SMO.

.DESCRIPTION
    Connects to source and target SQL Server instances, retrieves database
    properties via SMO and sys.databases, and generates a styled HTML comparison report.

.PARAMETER SourceServer
    Name or IP of the source SQL Server instance (e.g. "SQL01" or "SQL01,1733").

.PARAMETER TargetServer
    Name or IP of the target SQL Server instance.

.PARAMETER SourceDatabase
    Source database name, or "All" to compare every user database on the source.

.PARAMETER TargetDatabase
    Target database name, or "All" to compare every user database on the target.

.PARAMETER OutputPath
    Folder where the HTML report is saved. Defaults to the current directory.

.PARAMETER UseWindowsAuth
    Switch to use Windows Authentication (default).

.PARAMETER SourceCredential
    PSCredential for SQL Authentication on the source server (optional).

.PARAMETER TargetCredential
    PSCredential for SQL Authentication on the target server (optional).

.EXAMPLE
    .\Compare-SqlDatabases.ps1 -SourceServer "SQL01,1733" -TargetServer "SQL02,1733" `
        -SourceDatabase "All" -TargetDatabase "All" -UseWindowsAuth

.EXAMPLE
    .\Compare-SqlDatabases.ps1 -SourceServer "SQL01" -TargetServer "SQL02" `
        -SourceDatabase "AdventureWorks" -TargetDatabase "AdventureWorks" -UseWindowsAuth
#>

[CmdletBinding()]
param(
    [Parameter(Mandatory = $true)]  [string]$SourceServer,
    [Parameter(Mandatory = $true)]  [string]$TargetServer,
    [Parameter(Mandatory = $true)]  [string]$SourceDatabase,
    [Parameter(Mandatory = $true)]  [string]$TargetDatabase,
    [Parameter(Mandatory = $false)] [string]$OutputPath = (Get-Location).Path,
    [Parameter(Mandatory = $false)] [switch]$UseWindowsAuth,
    [Parameter(Mandatory = $false)] [System.Management.Automation.PSCredential]$SourceCredential,
    [Parameter(Mandatory = $false)] [System.Management.Automation.PSCredential]$TargetCredential
)

# ── Set-StrictMode -Version Latest is intentionally omitted.
# ── It raises PropertyNotFoundStrict on .Count when a single-item result
# ── is unrolled from a function return into a bare PSCustomObject.
$ErrorActionPreference = "Stop"

# ---------------------------------------------------------------------------
#region  HTML ENCODING HELPER
# ---------------------------------------------------------------------------
function ConvertTo-HtmlEncoded {
    <#
    .SYNOPSIS
        Safe HTML encoding using only built-in string operations.
        Replaces [System.Web.HttpUtility]::HtmlEncode() which requires the
        System.Web assembly — unavailable by default in PS 5.1 and absent in PS 7+.
    #>
    param([Parameter(Mandatory)][AllowEmptyString()][string]$Text)

    if ([string]::IsNullOrEmpty($Text)) { return "" }

    # Ampersand MUST be encoded first to prevent double-encoding of later sequences
    $Text = $Text.Replace('&',  '&amp;')
    $Text = $Text.Replace('<',  '&lt;')
    $Text = $Text.Replace('>',  '&gt;')
    $Text = $Text.Replace('"',  '&quot;')
    $Text = $Text.Replace("'",  '&#39;')
    return $Text
}
#endregion

# ---------------------------------------------------------------------------
#region  PROPERTY EXCLUSION LIST
# ---------------------------------------------------------------------------
# These property names are excluded from comparison output entirely.
#
# Root cause for Count/Length/LongLength/Rank/SyncRoot/IsReadOnly/IsFixedSize/IsSynchronized:
# ──────────────────────────────────────────────────────────────────────────────────────────
# When the comma-operator trick (, [PSCustomObject[]]$array) was combined with @() in the
# caller, the result was double-wrapped. $srcPropsArr[0] ended up being the entire inner
# PSCustomObject[] array — not a single row. Iterating .PSObject.Properties on a System.Array
# object surfaces all array-level metadata properties listed below.
#
# Root fix  : Get-DatabaseProperties no longer uses the comma operator. The caller uses @()
#             which correctly flattens a returned array into individual elements.
# Safety net: This exclusion list catches any residual array-artifact properties so they
#             never appear in the report regardless of how the data flows through.
$script:ExcludeProperties = [System.Collections.Generic.HashSet[string]]::new(
    [System.StringComparer]::OrdinalIgnoreCase
)
@(
    # .NET System.Array artifact properties
    "Count", "Length", "LongLength", "Rank",
    "SyncRoot", "IsReadOnly", "IsFixedSize", "IsSynchronized"
) | ForEach-Object { [void]$script:ExcludeProperties.Add($_) }

# These properties are SHOWN in the report but excluded from the diff count.
$script:InfoOnlyProperties = [System.Collections.Generic.HashSet[string]]::new(
    [System.StringComparer]::OrdinalIgnoreCase
)
@(
    "DatabaseName", "CreateDate", "DataSizeMB", "LogSizeMB"
) | ForEach-Object { [void]$script:InfoOnlyProperties.Add($_) }
#endregion

# ---------------------------------------------------------------------------
#region  SMO ASSEMBLY LOADER
# ---------------------------------------------------------------------------
function Import-SmoAssemblies {
    $smoLoaded = $false
    try {
        $null = [Microsoft.SqlServer.Management.Smo.Server]
        $null = [Microsoft.SqlServer.Management.Common.ServerConnection]
        $smoLoaded = $true
    } catch { $smoLoaded = $false }

    if ($smoLoaded) { Write-Verbose "SMO assemblies already loaded."; return }

    # Attempt 1: SqlServer module (preferred)
    if (Get-Module -ListAvailable -Name "SqlServer" -ErrorAction SilentlyContinue) {
        try {
            Import-Module SqlServer -DisableNameChecking -ErrorAction Stop
            Write-Verbose "SMO loaded via SqlServer module."
            return
        } catch { Write-Warning "SqlServer module import failed: $($_.Exception.Message)" }
    }

    # Attempt 2: SQLPS module
    if (Get-Module -ListAvailable -Name "SQLPS" -ErrorAction SilentlyContinue) {
        try {
            Import-Module SQLPS -DisableNameChecking -ErrorAction Stop
            Write-Verbose "SMO loaded via SQLPS module."
            return
        } catch { Write-Warning "SQLPS module import failed: $($_.Exception.Message)" }
    }

    # Attempt 3: GAC fallback (legacy Windows)
    foreach ($asm in @(
        "Microsoft.SqlServer.Smo",
        "Microsoft.SqlServer.ConnectionInfo",
        "Microsoft.SqlServer.Management.Sdk.Sfc",
        "Microsoft.SqlServer.SqlEnum"
    )) {
        try   { [System.Reflection.Assembly]::LoadWithPartialName($asm) | Out-Null }
        catch { Write-Warning "Could not load '$asm': $($_.Exception.Message)" }
    }

    # Final validation
    try {
        $null = [Microsoft.SqlServer.Management.Smo.Server]
        $null = [Microsoft.SqlServer.Management.Common.ServerConnection]
    } catch {
        throw "SMO types are unavailable. Install SSMS or run: Install-Module SqlServer"
    }
}
#endregion

# ---------------------------------------------------------------------------
#region  CONNECTION FACTORY
# ---------------------------------------------------------------------------
function Connect-SqlServer {
    param(
        [Parameter(Mandatory)] [string]$ServerName,
        [System.Management.Automation.PSCredential]$Credential = $null,
        [bool]$WindowsAuth = $true
    )

    Write-Host "  Connecting to: $ServerName ..." -ForegroundColor Cyan
    try {
        $conn = New-Object Microsoft.SqlServer.Management.Common.ServerConnection
        $conn.ServerInstance   = $ServerName
        $conn.ConnectTimeout   = 30
        $conn.StatementTimeout = 120

        if ($WindowsAuth -or ($null -eq $Credential)) {
            $conn.LoginSecure = $true
        } else {
            $conn.LoginSecure    = $false
            $conn.Login          = $Credential.UserName
            $conn.SecurePassword = $Credential.Password
        }

        $smo = New-Object Microsoft.SqlServer.Management.Smo.Server($conn)
        $ver = $smo.VersionString
        if ([string]::IsNullOrWhiteSpace($ver)) {
            throw "Server returned empty version string — instance may be unavailable."
        }

        Write-Host ("  OK  {0}  [SQL Server {1}  |  Edition: {2}]" -f `
            $ServerName, $ver, $smo.Edition) -ForegroundColor Green
        return $smo

    } catch [Microsoft.SqlServer.Management.Common.ConnectionFailureException] {
        Write-Error ("Connection failure for '$ServerName': $($_.Exception.Message) " +
                     "— Check server name, port, firewall, and SQL Browser service.")
        return $null
    } catch {
        Write-Error "Unexpected error connecting to '$ServerName': $($_.Exception.Message)"
        return $null
    }
}
#endregion

# ---------------------------------------------------------------------------
#region  DATABASE PROPERTY RETRIEVAL
# ---------------------------------------------------------------------------
function Get-DatabaseProperties {
    <#
    .SYNOPSIS
        Queries sys.databases + sys.master_files.
        Returns a plain PSCustomObject[] — no comma-operator wrapping.
        The caller wraps with @() to guarantee array behaviour.

    .NOTES
        Previous versions used the comma operator trick (, [PSCustomObject[]]$array)
        to prevent PowerShell unrolling a single-row result.  Combined with @() in the
        caller this created a double-wrap: $srcPropsArr[0] returned the entire inner
        array instead of a single PSCustomObject, causing array metadata properties
        (Count, Length, SyncRoot, etc.) to appear in the comparison output.

        Fix: return the array directly. The caller's @() wrapper handles single-row
        results safely without creating a second layer of wrapping.
    #>
    param(
        [Parameter(Mandatory)] [Microsoft.SqlServer.Management.Smo.Server]$SmoServer,
        [Parameter(Mandatory)] [string]$DatabaseName
    )

    $safeDbName  = $DatabaseName.Replace("'", "''")
    $whereClause = if ($DatabaseName -eq "All") {
        "WHERE d.database_id > 4"
    } else {
        "WHERE d.name = N'$safeDbName'"
    }

    $query = @"
SELECT
    d.name                                          AS [DatabaseName],
    d.compatibility_level                           AS [CompatibilityLevel],
    d.collation_name                                AS [Collation],
    d.recovery_model_desc                           AS [RecoveryModel],
    d.state_desc                                    AS [State],
    d.user_access_desc                              AS [UserAccess],
    CAST(d.is_read_only              AS INT)        AS [ReadOnly],
    CAST(d.is_auto_close_on          AS INT)        AS [AutoClose],
    CAST(d.is_auto_shrink_on         AS INT)        AS [AutoShrink],
    CAST(d.is_auto_create_stats_on   AS INT)        AS [AutoCreateStats],
    CAST(d.is_auto_update_stats_on   AS INT)        AS [AutoUpdateStats],
    CAST(d.is_fulltext_enabled       AS INT)        AS [FullTextEnabled],
    d.page_verify_option_desc                       AS [PageVerify],
    d.log_reuse_wait_desc                           AS [LogReuseWait],
    CAST(d.is_encrypted              AS INT)        AS [Encrypted],
    CAST(d.is_trustworthy_on         AS INT)        AS [Trustworthy],
    CAST(d.is_db_chaining_on         AS INT)        AS [DBChaining],
    CAST(d.is_broker_enabled         AS INT)        AS [BrokerEnabled],
    d.snapshot_isolation_state_desc                 AS [SnapshotIsolation],
    CAST(d.is_read_committed_snapshot_on AS INT)    AS [ReadCommittedSnapshot],
    CAST(d.is_ansi_null_default_on   AS INT)        AS [ANSINullDefault],
    CAST(d.is_ansi_nulls_on          AS INT)        AS [ANSINulls],
    CAST(d.is_ansi_padding_on        AS INT)        AS [ANSIPadding],
    CAST(d.is_ansi_warnings_on       AS INT)        AS [ANSIWarnings],
    CAST(d.is_arithabort_on          AS INT)        AS [ArithAbort],
    CAST(d.is_concat_null_yields_null_on AS INT)    AS [ConcatNullYieldsNull],
    CAST(d.is_numeric_roundabort_on  AS INT)        AS [NumericRoundAbort],
    CAST(d.is_quoted_identifier_on   AS INT)        AS [QuotedIdentifier],
    CAST(d.is_recursive_triggers_on  AS INT)        AS [RecursiveTriggers],
    CAST(d.is_cursor_close_on_commit_on AS INT)     AS [CursorCloseOnCommit],
    CAST(d.is_local_cursor_default   AS INT)        AS [LocalCursorDefault],
    CAST(d.is_parameterization_forced AS INT)       AS [ForcedParameterization],
    d.create_date                                   AS [CreateDate],
    CAST(ISNULL(
        (SELECT SUM(CAST(mf.size AS BIGINT)) * 8.0 / 1024
         FROM sys.master_files mf
         WHERE mf.database_id = d.database_id AND mf.type = 0), 0)
    AS DECIMAL(18,2))                               AS [DataSizeMB],
    CAST(ISNULL(
        (SELECT SUM(CAST(mf.size AS BIGINT)) * 8.0 / 1024
         FROM sys.master_files mf
         WHERE mf.database_id = d.database_id AND mf.type = 1), 0)
    AS DECIMAL(18,2))                               AS [LogSizeMB]
FROM sys.databases d
$whereClause
ORDER BY d.name;
"@

    try {
        $ds    = $SmoServer.Databases["master"].ExecuteWithResults($query)
        $table = $ds.Tables[0]

        if ($table.Rows.Count -eq 0) {
            Write-Warning ("No rows returned for '$DatabaseName' on '$($SmoServer.Name)'. " +
                           "Database may not exist or is offline.")
            # Return typed empty array — caller's @() handles this cleanly
            return [PSCustomObject[]]@()
        }

        $resultList = [System.Collections.Generic.List[PSCustomObject]]::new()
        foreach ($row in $table.Rows) {
            $obj = [ordered]@{}
            foreach ($col in $table.Columns) {
                $rawVal = $row[$col.ColumnName]
                # Normalise DBNull → empty string so all comparisons are string-safe
                $obj[$col.ColumnName] = if ($rawVal -is [System.DBNull]) { "" } else { "$rawVal" }
            }
            $resultList.Add([PSCustomObject]$obj)
        }

        # ── Return the array directly (no comma operator).
        # ── The caller uses @() which safely wraps a single PSCustomObject into
        # ── an array without creating a second layer of wrapping.
        return [PSCustomObject[]]$resultList.ToArray()

    } catch {
        Write-Error ("Failed to query '$DatabaseName' on '$($SmoServer.Name)': " +
                     $_.Exception.Message)
        return [PSCustomObject[]]@()
    }
}
#endregion

# ---------------------------------------------------------------------------
#region  COMPARISON ENGINE
# ---------------------------------------------------------------------------
function Compare-DatabaseProperties {
    param(
        [Parameter(Mandatory)] [PSCustomObject]$SourceRow,
        [Parameter(Mandatory)] [PSCustomObject]$TargetRow,
        [Parameter(Mandatory)] [string]$SourceDbName,
        [Parameter(Mandatory)] [string]$TargetDbName
    )

    $rows      = [System.Collections.Generic.List[PSCustomObject]]::new()
    $diffCount = 0

    foreach ($prop in $SourceRow.PSObject.Properties.Name) {

        # ── Skip array-artifact and unwanted properties entirely
        if ($script:ExcludeProperties.Contains($prop)) { continue }

        $srcVal = if ($null -ne $SourceRow.PSObject.Properties[$prop]) {
            "$($SourceRow.PSObject.Properties[$prop].Value)"
        } else { "N/A" }

        $tgtVal = if ($null -ne $TargetRow.PSObject.Properties[$prop]) {
            "$($TargetRow.PSObject.Properties[$prop].Value)"
        } else { "N/A" }

        $isInfo = $script:InfoOnlyProperties.Contains($prop)
        $isDiff = (-not $isInfo) -and ($srcVal -ne $tgtVal)
        if ($isDiff) { $diffCount++ }

        $rows.Add([PSCustomObject]@{
            Property   = $prop
            Source     = $srcVal
            Target     = $tgtVal
            IsDiff     = $isDiff
            IsInfoOnly = $isInfo
        })
    }

    return [PSCustomObject]@{
        SourceDatabase = $SourceDbName
        TargetDatabase = $TargetDbName
        Rows           = $rows
        DiffCount      = $diffCount
    }
}
#endregion

