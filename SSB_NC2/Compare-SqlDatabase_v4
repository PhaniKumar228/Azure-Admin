    # Summary cards
    [void]$sb.AppendLine(@"
<div class='summary'>
  <h2>&#128200; Comparison Summary</h2>
  <div class='cards'>
    <div class='card blue'  ><div class='lbl'>Databases Compared</div>  <div class='val'>$dbCount</div></div>
    <div class='card green' ><div class='lbl'>Fully Matching</div>       <div class='val'>$dbsClean</div></div>
    <div class='card red'   ><div class='lbl'>Databases with Diffs</div> <div class='val'>$dbsWithDiff</div></div>
    <div class='card orange'><div class='lbl'>Total Property Diffs</div> <div class='val'>$totalDiffs</div></div>
  </div>
</div>
<div class='content'>
"@)

    # Per-database blocks
    foreach ($comp in $ComparisonList) {
        $badgeCls  = if ($comp.DiffCount -gt 0) { "diff" } else { "ok" }
        $badgeTxt  = if ($comp.DiffCount -gt 0) {
            "&#9888; $($comp.DiffCount) Difference(s)"
        } else { "&#10003; Identical" }

        $dbLabel   = if ($comp.SourceDatabase -eq $comp.TargetDatabase) {
            ConvertTo-HtmlEncoded $comp.SourceDatabase
        } else {
            "$(ConvertTo-HtmlEncoded $comp.SourceDatabase) &#8594; $(ConvertTo-HtmlEncoded $comp.TargetDatabase)"
        }

        $propCount = $comp.Rows.Count

        [void]$sb.AppendLine(@"
<div class='db-block'>
  <div class='db-head'>
    <h3>&#128451; $dbLabel</h3>
    <div class='db-right'>
      <span class='db-meta'>$propCount properties</span>
      <span class='badge $badgeCls'>$badgeTxt</span>
    </div>
  </div>
  <table>
    <thead>
      <tr>
        <th>Property</th>
        <th>&#128190; Source &mdash; $(ConvertTo-HtmlEncoded $comp.SourceDatabase)</th>
        <th>&#127919; Target &mdash; $(ConvertTo-HtmlEncoded $comp.TargetDatabase)</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
"@)

        $infoRows   = $comp.Rows | Where-Object {  $_.IsInfoOnly }
        $configRows = $comp.Rows | Where-Object { -not $_.IsInfoOnly }

        if ($infoRows) {
            [void]$sb.AppendLine("<tr class='sec-lbl'><td colspan='4'>&#128202; Informational</td></tr>")
            foreach ($r in $infoRows) {
                $ep = ConvertTo-HtmlEncoded $r.Property
                $es = ConvertTo-HtmlEncoded $r.Source
                $et = ConvertTo-HtmlEncoded $r.Target
                [void]$sb.AppendLine(@"
      <tr class='r-info'>
        <td><span class='pn'>$ep</span></td>
        <td><span class='pv hi-info'>$es</span></td>
        <td><span class='pv hi-info'>$et</span></td>
        <td class='si'><span class='v-info'>&#8213;</span></td>
      </tr>
"@)
            }
        }

        if ($configRows) {
            [void]$sb.AppendLine("<tr class='sec-lbl'><td colspan='4'>&#9881; Configuration Properties</td></tr>")
            foreach ($r in $configRows) {
                $ep = ConvertTo-HtmlEncoded $r.Property
                $es = ConvertTo-HtmlEncoded $r.Source
                $et = ConvertTo-HtmlEncoded $r.Target
                if ($r.IsDiff) {
                    [void]$sb.AppendLine(@"
      <tr class='r-diff'>
        <td><span class='pn'>$ep</span></td>
        <td><span class='pv hi-diff'>$es</span></td>
        <td><span class='pv hi-diff'>$et</span></td>
        <td class='si'><span class='v-diff'>&#10007;</span></td>
      </tr>
"@)
                } else {
                    [void]$sb.AppendLine(@"
      <tr>
        <td><span class='pn'>$ep</span></td>
        <td><span class='pv'>$es</span></td>
        <td><span class='pv'>$et</span></td>
        <td class='si'><span class='v-ok'>&#10003;</span></td>
      </tr>
"@)
                }
            }
        }

        [void]$sb.AppendLine(@"
    </tbody>
  </table>
  <div class='legend'>
    <span class='ld'><span class='dot d'></span> Mismatch</span>
    <span class='ld'><span class='dot m'></span> Match</span>
    <span class='ld'><span class='dot i'></span> Informational (not compared)</span>
  </div>
</div>
"@)
    }

    # Comments
    if ($null -ne $Comments -and $Comments.Count -gt 0) {
        [void]$sb.AppendLine(@"
<div class='cmts'>
  <div class='cmts-head'>
    <span style='font-size:20px'>&#128204;</span>
    <h3>Notes &amp; Observations ($($Comments.Count))</h3>
  </div>
  <div class='cmts-body'>
"@)
        foreach ($c in $Comments) {
            $ico = switch ($c.Type) {
                "error"   { "&#10060;" }
                "warning" { "&#9888;"  }
                "info"    { "&#8505;"  }
                "success" { "&#10004;" }
                default   { "&#8226;"  }
            }
            $encodedMsg = ConvertTo-HtmlEncoded $c.Message
            [void]$sb.AppendLine(@"
    <div class='ci'>
      <span class='ci-ico'>$ico</span>
      <div>
        <span class='ct $($c.Type)'>$($c.Type)</span>
        <span class='cm'>$encodedMsg</span>
      </div>
    </div>
"@)
        }
        [void]$sb.AppendLine("  </div></div>")
    }

    # Footer
    [void]$sb.AppendLine(@"
</div>
<footer>
  Generated by <strong>Compare-SqlDatabases.ps1</strong> &bull; $reportDate &bull;
  <strong>$(ConvertTo-HtmlEncoded $SourceServerName)</strong> &rarr;
  <strong>$(ConvertTo-HtmlEncoded $TargetServerName)</strong> &bull;
  $dbCount database(s) &bull; $totalDiffs total difference(s)
</footer>
</body></html>
"@)

    try {
        [System.IO.File]::WriteAllText($reportFile, $sb.ToString(),
            [System.Text.Encoding]::UTF8)
        Write-Host "  Report saved: $reportFile" -ForegroundColor Green
        return $reportFile
    } catch {
        Write-Error "Failed to write report to '$reportFile': $($_.Exception.Message)"
        return $null
    }
}
#endregion

# ---------------------------------------------------------------------------
#region  MAIN ORCHESTRATION
# ---------------------------------------------------------------------------
function Invoke-Main {

    Write-Host "`n============================================" -ForegroundColor Cyan
    Write-Host "   SQL Server Database Comparison Tool"      -ForegroundColor Cyan
    Write-Host "============================================`n" -ForegroundColor Cyan

    $comments = [System.Collections.Generic.List[PSCustomObject]]::new()
    $srcSmo   = $null
    $tgtSmo   = $null

    # 1. Load SMO
    Write-Host "[1/4] Loading SMO assemblies..." -ForegroundColor Yellow
    try {
        Import-SmoAssemblies
        $comments.Add([PSCustomObject]@{ Type="success"
            Message="SMO assemblies loaded successfully." })
    } catch {
        Write-Error $_.Exception.Message; exit 1
    }

    # 2. Connect
    Write-Host "`n[2/4] Establishing connections..." -ForegroundColor Yellow

    $srcCred = $null
    $tgtCred = $null
    if (-not $UseWindowsAuth) {
        $srcCred = if ($null -ne $SourceCredential) { $SourceCredential } else {
            Get-Credential -Message "SQL credentials for SOURCE: $SourceServer" }
        $tgtCred = if ($null -ne $TargetCredential) { $TargetCredential } else {
            Get-Credential -Message "SQL credentials for TARGET: $TargetServer" }
    }

    $srcSmo = Connect-SqlServer -ServerName $SourceServer `
              -Credential $srcCred -WindowsAuth $UseWindowsAuth.IsPresent
    $tgtSmo = Connect-SqlServer -ServerName $TargetServer `
              -Credential $tgtCred -WindowsAuth $UseWindowsAuth.IsPresent

    if ($null -eq $srcSmo) {
        $comments.Add([PSCustomObject]@{ Type="error"
            Message="Failed to connect to source server: $SourceServer" })
        Write-Error "Aborting — source connection failed."; exit 1
    }
    if ($null -eq $tgtSmo) {
        $comments.Add([PSCustomObject]@{ Type="error"
            Message="Failed to connect to target server: $TargetServer" })
        Write-Error "Aborting — target connection failed."; exit 1
    }

    $comments.Add([PSCustomObject]@{ Type="info"
        Message="Source: $SourceServer — SQL Server $($srcSmo.VersionString), Edition: $($srcSmo.Edition)" })
    $comments.Add([PSCustomObject]@{ Type="info"
        Message="Target: $TargetServer — SQL Server $($tgtSmo.VersionString), Edition: $($tgtSmo.Edition)" })

    if ($srcSmo.VersionMajor -ne $tgtSmo.VersionMajor) {
        $comments.Add([PSCustomObject]@{ Type="warning"
            Message=("SQL Server major version mismatch — Source: $($srcSmo.VersionString) / " +
                     "Target: $($tgtSmo.VersionString). Some comparisons may be unreliable.") })
    }

    # 3. Resolve DB pairs
    Write-Host "`n[3/4] Resolving database pairs..." -ForegroundColor Yellow

    function Resolve-DbList {
        param(
            [Microsoft.SqlServer.Management.Smo.Server]$Smo,
            [string]$DbParam,
            [string]$Role
        )
        if ($DbParam -eq "All") {
            $dbNames = [System.Collections.Generic.List[string]]::new()
            foreach ($db in $Smo.Databases) {
                if ((-not $db.IsSystemObject) -and
                    ($db.Status -eq [Microsoft.SqlServer.Management.Smo.DatabaseStatus]::Normal)) {
                    $dbNames.Add($db.Name)
                }
            }
            $sorted = $dbNames | Sort-Object
            Write-Host ("  $Role 'All': found {0} user database(s) on {1}" -f `
                $dbNames.Count, $Smo.Name) -ForegroundColor White
            # Return array directly — caller uses @() for safety
            return [string[]]$sorted
        }
        $found = $false
        foreach ($db in $Smo.Databases) {
            if ($db.Name -eq $DbParam) { $found = $true; break }
        }
        if (-not $found) { throw "Database '$DbParam' was not found on $($Smo.Name)." }
        return [string[]]@($DbParam)
    }

    $srcDbs = $null
    $tgtDbs = $null
    try {
        [string[]]$srcDbs = @(Resolve-DbList -Smo $srcSmo -DbParam $SourceDatabase -Role "Source")
        [string[]]$tgtDbs = @(Resolve-DbList -Smo $tgtSmo -DbParam $TargetDatabase -Role "Target")
    } catch {
        $comments.Add([PSCustomObject]@{ Type="error"; Message=$_.Exception.Message })
        Write-Error $_.Exception.Message; exit 1
    }

    $pairs = [System.Collections.Generic.List[PSCustomObject]]::new()

    if ($SourceDatabase -eq "All" -and $TargetDatabase -eq "All") {
        $allNames = [System.Collections.Generic.HashSet[string]]::new(
            [System.StringComparer]::OrdinalIgnoreCase)
        foreach ($n in $srcDbs) { [void]$allNames.Add($n) }
        foreach ($n in $tgtDbs) { [void]$allNames.Add($n) }

        $srcSet = [System.Collections.Generic.HashSet[string]]::new(
            $srcDbs, [System.StringComparer]::OrdinalIgnoreCase)
        $tgtSet = [System.Collections.Generic.HashSet[string]]::new(
            $tgtDbs, [System.StringComparer]::OrdinalIgnoreCase)

        foreach ($n in ($allNames | Sort-Object)) {
            $inS = $srcSet.Contains($n)
            $inT = $tgtSet.Contains($n)
            if ($inS -and $inT) {
                $pairs.Add([PSCustomObject]@{ Src=$n; Tgt=$n })
            } elseif ($inS) {
                $msg = "'$n' exists on source ($SourceServer) but NOT on target ($TargetServer) — skipped."
                $comments.Add([PSCustomObject]@{ Type="warning"; Message=$msg })
                Write-Warning $msg
            } else {
                $msg = "'$n' exists on target ($TargetServer) but NOT on source ($SourceServer) — skipped."
                $comments.Add([PSCustomObject]@{ Type="warning"; Message=$msg })
                Write-Warning $msg
            }
        }
    } elseif ($SourceDatabase -eq "All") {
        foreach ($n in $srcDbs) { $pairs.Add([PSCustomObject]@{ Src=$n; Tgt=$TargetDatabase }) }
    } elseif ($TargetDatabase -eq "All") {
        foreach ($n in $tgtDbs) { $pairs.Add([PSCustomObject]@{ Src=$SourceDatabase; Tgt=$n }) }
    } else {
        $pairs.Add([PSCustomObject]@{ Src=$SourceDatabase; Tgt=$TargetDatabase })
    }

    if ($pairs.Count -eq 0) {
        Write-Warning "No comparable database pairs found. Verify inputs and server connectivity."
        exit 0
    }

    # 4. Compare
    Write-Host "`n[4/4] Comparing properties and generating report..." -ForegroundColor Yellow

    $allComparisons = [System.Collections.Generic.List[PSCustomObject]]::new()

    foreach ($pair in $pairs) {
        Write-Host ("  Comparing  [{0}]  vs  [{1}] ..." -f $pair.Src, $pair.Tgt) `
            -ForegroundColor White

        # @() ensures we always get an array — works correctly because
        # Get-DatabaseProperties now returns [PSCustomObject[]] directly (no comma operator).
        # $srcPropsArr[0] will therefore always be a single PSCustomObject row.
        [PSCustomObject[]]$srcPropsArr = @(Get-DatabaseProperties -SmoServer $srcSmo `
                                            -DatabaseName $pair.Src)
        [PSCustomObject[]]$tgtPropsArr = @(Get-DatabaseProperties -SmoServer $tgtSmo `
                                            -DatabaseName $pair.Tgt)

        if ($srcPropsArr.Count -eq 0) {
            $comments.Add([PSCustomObject]@{ Type="error"
                Message="No properties returned for '$($pair.Src)' on $SourceServer — skipped." })
            Write-Warning "  Skipped — no source data for '$($pair.Src)'."
            continue
        }
        if ($tgtPropsArr.Count -eq 0) {
            $comments.Add([PSCustomObject]@{ Type="error"
                Message="No properties returned for '$($pair.Tgt)' on $TargetServer — skipped." })
            Write-Warning "  Skipped — no target data for '$($pair.Tgt)'."
            continue
        }

        $cmp = Compare-DatabaseProperties `
            -SourceRow    $srcPropsArr[0] `
            -TargetRow    $tgtPropsArr[0] `
            -SourceDbName $pair.Src       `
            -TargetDbName $pair.Tgt

        if ($cmp.DiffCount -gt 0) {
            $diffProps = ($cmp.Rows | Where-Object { $_.IsDiff } |
                          Select-Object -ExpandProperty Property) -join ", "
            $comments.Add([PSCustomObject]@{ Type="warning"
                Message="'$($pair.Src)' — $($cmp.DiffCount) difference(s) in: $diffProps" })
            Write-Host "    $($cmp.DiffCount) difference(s) found" -ForegroundColor Yellow
        } else {
            $comments.Add([PSCustomObject]@{ Type="success"
                Message="'$($pair.Src)' — all compared properties are identical." })
            Write-Host "    All properties match" -ForegroundColor Green
        }

        $allComparisons.Add($cmp)
    }

    $reportPath = New-HtmlReport `
        -SourceServerName $SourceServer    `
        -TargetServerName $TargetServer    `
        -SourceSmo        $srcSmo          `
        -TargetSmo        $tgtSmo          `
        -ComparisonList   $allComparisons   `
        -Comments         $comments         `
        -ReportOutputPath $OutputPath

    if ($null -ne $reportPath) {
        $finalDiffs = 0
        foreach ($c in $allComparisons) { $finalDiffs += $c.DiffCount }

        Write-Host "`n============================================" -ForegroundColor Cyan
        Write-Host ("  Done!  DBs compared: {0}  |  Total diffs: {1}" -f `
            $allComparisons.Count, $finalDiffs) `
            -ForegroundColor $(if ($finalDiffs -gt 0) { "Yellow" } else { "Green" })
        Write-Host "  Report: $reportPath" -ForegroundColor Green
        Write-Host "============================================`n" -ForegroundColor Cyan

        try { Start-Process $reportPath } catch { <# non-fatal #> }
    }
}

Invoke-Main
#endregion
