$Words = @("\\infkc1p01","\\pamuit","\\PAMstorage")

Get-ChildItem -Path "C:\Scripts" -Recurse -Include *.xml,*.ini,*.config |
ForEach-Object {
    $File = $_.FullName

    foreach ($Word in $Words) {
        Select-String -Path $File -Pattern (:Escape($Word)) |
        Select-Object @{N='File';E={$_.Path}},
                      @{N='FoundText';E={$Word}},
                      LineNumber,
                      Line
    }
}
